FLASK_ENV=production
PORT=5000

# Painel: em nuvem, preencha usuario e senha para proteger a interface.
PANEL_USERNAME=admin
PANEL_PASSWORD=troque-esta-senha

# Webhook: use este token na URL configurada na Evolution API.
WEBHOOK_SECRET=troque-este-token
PUBLIC_BASE_URL=https://seu-app.onrender.com

# Banco de dados.
# Local: deixe vazio para usar SQLite em data/disparo.db.
# Nuvem: use a connection string do Supabase/Postgres.
DATABASE_URL=

# Evolution API.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
AUTHENTICATION_API_KEY=troque-esta-chave
INSTANCE_NAME=meu-whatsapp
EVOLUTION_TYPING_ENABLED=true

# IA via Groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cotacao por placa / FIPE.
# Provider padrao: buscafipe. Alternativas: apiplacas, custom.
PLACA_FIPE_PROVIDER=buscafipe
PLACA_FIPE_API_URL=https://buscafipe.com/api
PLACA_FIPE_API_KEY=

# FIPE padrao para fallback manual / consulta exata.
FIPE_PROVIDER=parallelum
FIPE_API_URL=https://parallelum.com.br/fipe/api/v1

# Se quiser calcular cota por percentual configuravel futuramente.
COTA_PERCENTUAL_FIPE=0.05

# Limites e delays humanos padrao.
DEFAULT_DAILY_LIMIT=80
DEFAULT_HOURLY_LIMIT=18
DEFAULT_DELAY_MIN_SECONDS=18
DEFAULT_DELAY_MAX_SECONDS=90
DEFAULT_BATCH_SIZE=10
DEFAULT_BATCH_PAUSE_MIN_SECONDS=420
DEFAULT_BATCH_PAUSE_MAX_SECONDS=1800
DUPLICATE_COOLDOWN_HOURS=72
SEND_WINDOW_START=08:00
SEND_WINDOW_END=18:00
